# Reference only: this app reads environment variables, not .env files.
# Enter values privately in Hamravesh's application environment panel.
APP_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-app.darkube.app,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.darkube.app
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=require
# Enable only after verifying ingress strips/sets X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=0
SENTRY_DSN=
APP_RELEASE=expense-manager@1.0.0
PORT=8000
WEB_CONCURRENCY=2
